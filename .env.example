# Core application
NODE_ENV=development
HOST=0.0.0.0
PORT=8080
VITE_WEB_PORT=5173
VITE_BASE_PATH=/
# Leave blank when the web client is served by the API (Docker production).
# For separate local Vite development, use http://localhost:8080.
VITE_API_BASE_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:5173

# PostgreSQL
# Local development database:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wild_ideas
# Docker Compose database hostname:
DATABASE_URL_DOCKER=postgresql://postgres:postgres@db:5432/wild_ideas
POSTGRES_DB=wild_ideas
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Shared public-workspace identity. This is not a login account.
PUBLIC_USER_NAME=public

# Optional: enables the administration API only for callers that send the
# exact value in the x-admin-token request header. Leave unset to disable it.
ADMIN_TOKEN=

# AI providers (configure at least one provider before using agent models).
OPENAI_API_KEY=
OPENAI_BASE_URL=
XAI_API_KEY=

# Optional search providers
BRAVE_SEARCH_API_KEY=
SERPER_API_KEY=

# Optional Google OAuth integration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/integrations/google/callback

# Optional social integrations
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TWITTER_REDIRECT_URI=http://localhost:8080/api/integrations/twitter/callback
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:8080/api/integrations/meta/callback

# Mobile (copy this value into artifacts/mobile/.env for Expo development)
EXPO_PUBLIC_API_URL=http://localhost:8080
EXPO_PUBLIC_DOMAIN=localhost:8080